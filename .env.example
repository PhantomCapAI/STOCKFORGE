# ============================================================================
# PHANTOM STOCKFORGE — environment template
# Copy to `.env` and fill in. NEVER commit `.env`. Secrets live ONLY here.
# ============================================================================

# ---- Global safety -----------------------------------------------------------
# Master kill switch. When true, NOTHING hits the chain: launches/claims are
# simulated and logged only. Flip to false ONLY when you intend real money.
STOCKFORGE_DRY_RUN=true

# When true, every real launch AND every real claim must be approved by a human
# in Telegram before it executes. Strongly recommended: true.
STOCKFORGE_REQUIRE_APPROVAL=true

# Log level: DEBUG | INFO | WARNING | ERROR
STOCKFORGE_LOG_LEVEL=INFO

# SQLite state file.
STOCKFORGE_DB_PATH=./data/stockforge.sqlite

# ---- Bankr -------------------------------------------------------------------
# Which backend to launch through: "cli" (uses the `bankr` CLI) or "rest"
# (uses https://api.bankr.bot/agent/prompt). Both honor DRY_RUN.
BANKR_BACKEND=rest

# REST base URL (verified from docs.bankr.bot). Override only if Bankr changes it.
BANKR_API_BASE=https://api.bankr.bot

# Agent API key (bk_...). Get one at https://bankr.bot/api
# Used as the `X-API-Key` header on POST /agent/prompt.
BANKR_API_KEY=

# Path to the `bankr` binary when BANKR_BACKEND=cli (default: found on PATH).
BANKR_CLI_BIN=bankr

# Agent wallet private key (0x...). Used ONLY by `bankr fees claim-wallet`
# (headless claim). Leave blank to disable wallet-side claiming; the agent then
# builds unsigned claim txs via POST /public/doppler/build-claim for you to sign.
# If you set this, it is a hot key — fund it minimally and rotate often.
BANKR_PRIVATE_KEY=

# Creator/beneficiary address that receives the 95% creator fee split.
# Used for read-only fee polling (no key required).
BANKR_BENEFICIARY_ADDRESS=

# ---- Launch policy -----------------------------------------------------------
# Default chain: "base" or "robinhood". Stock-paired launches require robinhood.
STOCKFORGE_DEFAULT_CHAIN=base

# Max real launches per calendar day (your own budget, <= Bankr's 50/100 cap).
STOCKFORGE_DAILY_LAUNCH_BUDGET=3

# Minimum attention score (0-100) a narrative must reach to be launch-eligible.
STOCKFORGE_MIN_ATTENTION_SCORE=65

# Seconds between orchestrator ticks.
STOCKFORGE_TICK_SECONDS=60

# Turn vesting off on launches (100% to pool). Default false = keep 15% vesting.
STOCKFORGE_DISABLE_VESTING=false

# ---- Telegram control plane --------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat ID that is allowed to command the agent + receives approval prompts.
# Only this chat is trusted; commands from anywhere else are ignored.
TELEGRAM_CHAT_ID=

# ---- Concept forge (LLM) -----------------------------------------------------
# Provider for concept generation. "none" = use the built-in deterministic
# template forge (no external calls). "openai_compatible" = any OpenAI-style
# chat-completions endpoint (OpenRouter, Bankr LLM gateway, local, etc.).
FORGE_LLM_PROVIDER=none
FORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
FORGE_LLM_API_KEY=
FORGE_LLM_MODEL=anthropic/claude-sonnet-4-6

# ---- Signal sources ----------------------------------------------------------
# Comma-separated tickers to watch for narratives.
STOCKFORGE_WATCHLIST=NVDA,GME,TSLA,HOOD,SPY,AMD,PLTR,MSTR
